{
  "name": "justforfun-ui",
  "version": "0.0.0-dev.1",
  "description": "An out-of-the-box library of UI components",
  "keywords": [
    "justforfun-ui",
    "justforfun",
    "vue",
    "ui",
    "components library"
  ],
  "homepage": "https://zhaolan666.github.io/JustForFun/",
  "author": "mingdu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/element-plus/element-plus/issues"
  },
  "main": "index.ts",
  "module": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./es": {
      "types": "./es/index.d.mts",
      "import": "./es/index.mjs"
    },
    "./lib": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    },
    "./es/*": {
      "types": "./es/*.d.mts",
      "import": "./es/*.mjs"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "require": "./lib/*.js"
    },
    "./theme-chalk/*": {
      "types": "./theme-chalk/*.d.ts",
      "import": "./theme-chalk/*.css",
      "require": "./theme-chalk/*.css"
    },
    "./components/*": {
      "types": "./es/components/*/index.d.mts",
      "import": "./es/components/*/index.mjs",
      "require": "./lib/components/*/index.js"
    },
    "./es/components/*": {
      "types": "./es/components/*/index.d.mts",
      "import": "./es/components/*/index.mjs"
    },
    "./lib/components/*": {
      "types": "./lib/components/*/index.d.ts",
      "require": "./lib/components/*/index.js"
    },
    "./components": {
      "types": "./components.ts",
      "import": "./components.ts",
      "require": "./components.ts"
    },
    "./theme-chalk": {
      "types": "./theme-chalk.ts",
      "import": "./theme-chalk.ts",
      "require": "./theme-chalk.ts"
    },
    "./resolver": {
      "types": "./resolver.ts",
      "import": "./resolver.ts",
      "require": "./resolver.ts"
    },
    "./style-loader": {
      "types": "./style-loader.ts",
      "import": "./style-loader.ts",
      "require": "./style-loader.ts"
    }
  },
  "unpkg": "dist/index.full.js",
  "jsdelivr": "dist/index.full.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaolan666/JustForFun.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "style": "dist/index.css",
  "sideEffects": [
    "dist/*",
    "theme-chalk/**/*.css",
    "theme-chalk/src/**/*.scss",
    "es/components/*/style/*",
    "lib/components/*/style/*",
    "**/*.css",
    "**/*.scss"
  ],
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@vueuse/core": "^14.3.0",
    "async-validator": "^4.2.5",
    "dayjs": "^1.11.20",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "normalize-wheel-es": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "browserslist": [
    "> 1%",
    "not ie 11",
    "not op_mini all"
  ]
}
