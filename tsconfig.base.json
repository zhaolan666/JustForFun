{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "target": "ES2018",
    "module": "ESNext",
    "baseUrl": ".",
    "sourceMap": false,
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "removeComments": false,
    "preserveSymlinks": true,
    "rootDir": ".",
    "types": ["vue", "unplugin-vue-macros/macros-global"],
    "paths": {
      "@justforfun-ui/*": ["packages/*"],
      "vue": ["./node_modules/vue"],
      "@vue/runtime-core": ["./node_modules/.pnpm/@vue+runtime-core@3.5.34/node_modules/@vue/runtime-core"],
      "@vue/runtime-dom": ["./node_modules/.pnpm/@vue+runtime-dom@3.5.34/node_modules/@vue/runtime-dom"],
      "@vueuse/core": ["./node_modules/.pnpm/@vueuse+core@12.4.0_typescript@6.0.3/node_modules/@vueuse/core"],
      "unplugin-vue-components": ["./node_modules/.pnpm/unplugin-vue-components@32.1.0_vue@3.5.34_typescript@6.0.3/node_modules/unplugin-vue-components"],
      "justforfun-ui": ["./packages/justforfun-ui"],
      "justforfun-ui/*": ["./packages/justforfun-ui/*"]
    },
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["ES2018", "DOM", "DOM.Iterable"]
  }
}
