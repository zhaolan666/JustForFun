    "@justforfun-ui/build-utils": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "chalk": "^5.6.2",
    "consola": "^3.4.2",
    "fast-glob": "^3.3.3",
    "lodash-es": "^4.18.1",
    "npm-run-all": "^4.1.5",
    "octokit": "^5.0.5",
    "tsx": "^4.22.3"
  }
