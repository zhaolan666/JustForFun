{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "ignoreDeprecations": "6.0",
    "skipLibCheck": false,
    "moduleResolution": "Node"
  },
  "include": [
    "packages/components/**/src/**/*",
    "packages/utils/**/*",
    "packages/hooks/**/*",
    "typings/**/*.d.ts",
    "play/**/*.ts",
    "play/**/*.d.ts",
    "play/**/*.vue"
  ],
  "exclude": [
    "**/__tests__/**/*",
    "**/node_modules",
    "packages/components/node_modules"
  ]
}

