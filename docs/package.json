{
  "name": "@justforfun-ui/docs",
  "author": "mingdu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "pnpm gen-locale && vitepress dev .",
    "build": "NODE_ENV=production && vitepress build . && tsx .vitepress/build/rebuild-pwa.ts",
    "serve": "NODE_ENV=production  vitepress serve . --port 6000",
    "gen-locale": "rimraf .vitepress/i18n && tsx .vitepress/build/crowdin-generate.ts",
    "crowdin:upload": "crowdin upload sources",
    "crowdin:list": "crowdin list project",
    "crowdin:dryrun": "crowdin download --dryrun",
    "crowdin:cn": "crowdin download -l zh-CN",
    "crowdin:tw": "crowdin download -l zh-TW",
    "crowdin-credentials": "tsx .vitepress/build/crowdin-credentials.ts"
  },
  "dependencies": {
    "@docsearch/js": "^3.1.0",
    "@element-plus/icons-vue": "^2.0.9",
    "@justforfun-ui/metadata": "workspace:*",
    "@vue/shared": "^3.2.37",
    "@vueuse/core": "^9.1.0",
    "axios": "^1.3.5",
    "clipboard-copy": "^4.0.1",
    "justforfun-ui": "npm:justforfun-ui@latest",
    "markdown-it": "^13.0.1",
    "normalize.css": "^8.0.1",
    "prism-theme-vars": "^0.2.4",
    "vue": "^3.2.45"
  },
  "devDependencies": {
    "@crowdin/cli": "^3.7.8",
    "@docsearch/react": "^3.1.0",
    "@justforfun-ui/build": "workspace:*",
    "@justforfun-ui/build-constants": "workspace:*",
    "@justforfun-ui/build-utils": "workspace:*",
    "@iconify-json/ri": "^1.1.3",
    "@types/markdown-it": "^12.2.3",
    "@vitejs/plugin-vue-jsx": "^1.3.10",
    "consola": "^2.15.3",
    "escape-html": "^1.0.3",
    "fast-glob": "^3.2.11",
    "markdown-it-container": "^3.0.0",
    "chalk": "^4.1.2",
    "octokit": "^2.0.3",
    "prismjs": "^1.28.0",
    "unocss": "^0.51.4",
    "unplugin-icons": "^0.16.1",
    "unplugin-vue-components": "^0.24.1",
    "unplugin-vue-macros": "^2.0.0",
    "vite": "^4.1.0",
    "vite-plugin-inspect": "^0.7.21",
    "vite-plugin-mkcert": "^1.7.2",
    "vite-plugin-pwa": "^0.14.7",
    "vitepress": "1.0.0-alpha.65"
  }
}
