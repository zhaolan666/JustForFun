{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@justforfun-ui/components/*": ["../packages/components/*"],
      "@justforfun-ui/theme-chalk/*": ["../packages/theme-chalk/*"],
      "@justforfun-ui/utils/*": ["../packages/utils/*"],
      "@justforfun-ui/hooks/*": ["../packages/hooks/*"],
      "@justforfun-ui/constants/*": ["../packages/constants/*"],
      "@justforfun-ui/locale/*": ["../packages/locale/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "env.d.ts", "types/**/*.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
